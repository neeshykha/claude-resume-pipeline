__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/

# Virtual environment
.venv/
venv/
env/

# macOS
.DS_Store

# Editor
.vscode/
.idea/

# Claude Code local config — only settings.json is tracked; everything else
